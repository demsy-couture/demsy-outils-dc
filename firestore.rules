rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Personnel actif (compte présent dans la collection "users" et non désactivé)
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    // Responsable
    function isManager() {
      return isStaff() && profile().role == 'manager';
    }

    // Comptes du personnel
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if isManager();
    }

    // Clients, commandes, images : tout le personnel ; suppression : responsable
    match /clients/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
    match /orders/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
    match /orderImages/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }

    // Rendez-vous : tout le personnel
    match /rdv/{id} {
      allow read, create, update, delete: if isStaff();
    }

    // Compteur des numéros de commande
    match /counters/{id} {
      allow read, write: if isStaff();
    }

    // Finances : le personnel peut enregistrer, seul le responsable peut lire/modifier
    match /finance/{id} {
      allow create: if isStaff();
      allow read, update, delete: if isManager();
    }
    match /payments/{id} {
      allow create: if isStaff();
      allow read, update, delete: if isManager();
    }

    // Journal d'activité : tout le monde écrit, seul le responsable lit, personne ne modifie
    match /logs/{id} {
      allow create: if isStaff();
      allow read: if isManager();
      allow update, delete: if false;
    }
  }
}
